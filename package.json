{
  "name": "seatable-plugin-online-courses",
  "private": true,
  "dependencies": {
    "@types/node": "^16.18.69",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "deep-copy": "^1.4.2",
    "dtable-store": "6.1.4",
